
/* =========================================
   SUSHEGAD GOA - GLOBAL STYLES
========================================= */

@import './variables.css';

/* Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: var(--navbar-height);
}

body {
  font-family: var(--font-body);
  background: var(--background);
  color: var(--text-primary);
  font-size: var(--text-base);
  line-height: 1.6;
  overflow-x: hidden;
}

body,
button,
input,
textarea,
select {
  font-family: var(--font-body);
}

button,
input,
textarea,
select {
  font-size: inherit;
}

button {
  cursor: pointer;
  border: none;
}

a {
  text-decoration: none;
  color: inherit;
}

img {
  display: block;
  max-width: 100%;
}

ul {
  list-style: none;
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 3px solid rgba(61, 188, 168, 0.5);
  outline-offset: 3px;
}

/* Typography */
h1,
h2,
h3,
h4,
h5 {
  color: var(--text-primary);
  line-height: 1.2;
}

h1,
h2 {
  font-family: var(--font-heading);
  font-weight: 700;
}

h1 {
  font-size: var(--text-5xl);
}

h2 {
  font-size: var(--text-3xl);
}

h3 {
  font-size: var(--text-xl);
}

p {
  color: var(--text-secondary);
}

.text-primary {
  color: var(--primary);
}

.text-turquoise {
  color: var(--turquoise);
}

.text-coral {
  color: var(--coral);
}

.text-muted {
  color: var(--text-muted);
}

/* Layout */
.container {
  width: min(92%, var(--container-width));
  margin: 0 auto;
}

.section {
  padding: var(--section-padding) 0;
}

.section-heading {
  max-width: 680px;
  margin-bottom: 36px;
}

.section-heading h2 {
  margin-bottom: 12px;
}

.section-heading p {
  font-size: var(--text-lg);
}

.section-eyebrow {
  display: inline-block;
  color: var(--primary);
  background: var(--turquoise-light);
  padding: 7px 15px;
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 800;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  margin-bottom: 16px;
}

/* Buttons */
.btn {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 9px;
  padding: 12px 23px;
  border-radius: var(--radius-full);
  font-weight: 700;
  transition: var(--transition-normal);
  border: 1px solid transparent;
}

.btn-primary {
  color: var(--text-white);
  background: var(--primary);
}

.btn-primary:hover {
  background: var(--primary-dark);
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.btn-secondary {
  background: var(--turquoise-light);
  color: var(--primary);
}

.btn-secondary:hover {
  background: var(--turquoise);
  color: white;
}

.btn-yellow {
  background: var(--yellow);
  color: var(--text-primary);
}

.btn-yellow:hover {
  background: #F3B83F;
  transform: translateY(-2px);
}

.btn-outline {
  color: var(--primary);
  background: transparent;
  border-color: var(--primary);
}

.btn-outline:hover {
  background: var(--primary);
  color: white;
}

.btn-coral {
  background: var(--coral);
  color: white;
}

.btn-coral:hover {
  background: #EC594D;
}

/* Navigation */
.navbar {
  height: var(--navbar-height);
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 1000;
  backdrop-filter: blur(14px);
}

.navbar-inner {
  height: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--primary);
  font-weight: 800;
  font-size: 1.4rem;
}

.logo span {
  font-family: var(--font-heading);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 30px;
}

.nav-links a {
  color: var(--text-secondary);
  font-weight: 600;
  transition: var(--transition-fast);
}

.nav-links a:hover,
.nav-links a.active {
  color: var(--primary);
}

/* Hero */
.hero {
  min-height: 590px;
  position: relative;
  display: flex;
  align-items: center;
  color: white;
  background-size: cover;
  background-position: center;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgba(0, 45, 44, 0.82),
    rgba(0, 45, 44, 0.35),
    rgba(0, 45, 44, 0.05)
  );
}

.hero-content {
  position: relative;
  z-index: 1;
  max-width: 720px;
}

.hero h1 {
  color: white;
  font-size: clamp(2.8rem, 6vw, 5rem);
  margin-bottom: 20px;
}

.hero p {
  color: rgba(255, 255, 255, 0.9);
  font-size: var(--text-lg);
  max-width: 590px;
  margin-bottom: 28px;
}

/* Search */
.search-box {
  display: flex;
  align-items: center;
  gap: 12px;
  background: white;
  padding: 10px 12px 10px 20px;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-lg);
  max-width: 650px;
}

.search-box input {
  flex: 1;
  min-width: 0;
  border: none;
  outline: none;
  color: var(--text-primary);
  background: transparent;
}

.search-box input::placeholder {
  color: var(--text-muted);
}

/* Forms */
.form-container {
  background: white;
  padding: 32px;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
  border: 1px solid var(--border);
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 18px;
}

.form-group label {
  color: var(--text-primary);
  font-weight: 700;
  font-size: var(--text-sm);
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 13px 15px;
  border: 1px solid var(--border-dark);
  border-radius: var(--radius-md);
  background: var(--surface-soft);
  color: var(--text-primary);
  outline: none;
  transition: var(--transition-fast);
}

.form-group textarea {
  resize: vertical;
  min-height: 120px;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color: var(--turquoise);
  background: white;
  box-shadow: 0 0 0 3px rgba(61, 188, 168, 0.12);
}

/* Cards */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: var(--transition-normal);
}

.card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-lg);
}

.card-image {
  width: 100%;
  height: 230px;
  object-fit: cover;
}

.card-content {
  padding: 20px;
}

.card-title {
  font-size: var(--text-xl);
  margin-bottom: 8px;
}

.card-description {
  font-size: var(--text-sm);
  line-height: 1.7;
}

/* Destination / Hotel / Restaurant grids */
.destination-grid,
.hotel-grid,
.restaurant-grid,
.package-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 25px;
}

.place-card,
.hotel-card,
.restaurant-card,
.package-card {
  position: relative;
  background: white;
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
  transition: var(--transition-normal);
}

.place-card:hover,
.hotel-card:hover,
.restaurant-card:hover,
.package-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-lg);
}

.place-card img,
.hotel-card img,
.restaurant-card img,
.package-card img {
  width: 100%;
  height: 235px;
  object-fit: cover;
}

.place-card-content,
.hotel-card-content,
.restaurant-card-content,
.package-card-content {
  padding: 20px;
}

/* Badges */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 6px 12px;
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 800;
}

.badge-primary {
  color: var(--primary);
  background: var(--turquoise-light);
}

.badge-yellow {
  color: #805B00;
  background: var(--yellow-light);
}

.badge-coral {
  color: #B83D34;
  background: var(--coral-light);
}

.badge-pink {
  color: #B52E65;
  background: var(--pink-light);
}

/* Rating */
.rating {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #B27A00;
  font-weight: 700;
}

/* Price */
.price {
  color: var(--primary);
  font-size: var(--text-xl);
  font-weight: 800;
}

.price small {
  color: var(--text-muted);
  font-size: var(--text-xs);
  font-weight: 500;
}

/* Filters */
.filters {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  margin-bottom: 28px;
}

.filter-select {
  border: 1px solid var(--border);
  background: white;
  color: var(--text-primary);
  border-radius: var(--radius-full);
  padding: 10px 16px;
  outline: none;
}

.filter-chip {
  padding: 9px 17px;
  border: 1px solid var(--border);
  background: white;
  border-radius: var(--radius-full);
  color: var(--text-secondary);
  font-weight: 600;
  transition: var(--transition-fast);
}

.filter-chip:hover,
.filter-chip.active {
  background: var(--primary);
  border-color: var(--primary);
  color: white;
}

/* Map */
.map-container {
  width: 100%;
  height: 480px;
  border-radius: var(--radius-xl);
  overflow: hidden;
  border: 1px solid var(--border);
  box-shadow: var(--shadow-md);
  z-index: 1;
}

.leaflet-container {
  width: 100%;
  height: 100%;
  font-family: var(--font-body);
  z-index: 1;
}

.leaflet-popup-content-wrapper {
  border-radius: 12px;
}

.leaflet-popup-content {
  font-family: var(--font-body);
}

/* Location controls */
.location-button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 11px 17px;
  background: var(--turquoise-light);
  color: var(--primary);
  border-radius: var(--radius-full);
  font-weight: 700;
}

.location-button:hover {
  background: var(--turquoise);
  color: white;
}

/* Saved places drawer */
.drawer-overlay {
  position: fixed;
  inset: 0;
  z-index: 2000;
  background: rgba(0, 30, 30, 0.45);
  backdrop-filter: blur(3px);
}

.saved-drawer {
  position: fixed;
  top: 0;
  right: 0;
  height: 100%;
  width: min(420px, 92vw);
  z-index: 2001;
  background: white;
  padding: 28px;
  overflow-y: auto;
  box-shadow: var(--shadow-lg);
}

/* Toast notifications */
.toast {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 3000;
  background: var(--primary-dark);
  color: white;
  padding: 14px 22px;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lg);
}

/* Newsletter */
.newsletter {
  background: var(--primary);
  border-radius: var(--radius-xl);
  padding: 55px 35px;
  text-align: center;
  color: white;
}

.newsletter h2 {
  color: white;
  margin-bottom: 12px;
}

.newsletter p {
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 24px;
}

/* Footer */
.footer {
  background: #073F3F;
  color: white;
  padding: 65px 0 25px;
  margin-top: 70px;
}

.footer h3,
.footer h4 {
  color: white;
  margin-bottom: 15px;
}

.footer p,
.footer a {
  color: rgba(255, 255, 255, 0.72);
}

.footer a:hover {
  color: var(--yellow);
}

.footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  margin-top: 40px;
  padding-top: 20px;
  text-align: center;
}

/* Empty states */
.empty-state {
  padding: 55px 20px;
  text-align: center;
  background: var(--surface-soft);
  border-radius: var(--radius-lg);
}

.empty-state h3 {
  margin-bottom: 10px;
}

/* Loading */
.loader {
  width: 38px;
  height: 38px;
  border: 4px solid var(--turquoise-light);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 25px auto;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* Utility classes */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grid {
  display: grid;
}

.gap-2 {
  gap: var(--space-2);
}

.gap-4 {
  gap: var(--space-4);
}

.mt-4 {
  margin-top: var(--space-4);
}

.mt-8 {
  margin-top: var(--space-8);
}

.mb-4 {
  margin-bottom: var(--space-4);
}

.text-center {
  text-align: center;
}

.hidden {
  display: none !important;
}

/* =========================================
   HOMEPAGE CARD ENHANCEMENTS
========================================= */

.home-category-card,
.home-destination-card {
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.home-category-card:hover,
.home-destination-card:hover {
  transform: translateY(-7px);
  box-shadow: 0 16px 38px rgba(0, 77, 76, 0.13) !important;
}

.home-destination-card img {
  transition: transform 0.5s ease;
}

.home-destination-card:hover img {
  transform: scale(1.045);
}

.home-category-card h3,
.home-destination-card h3 {
  transition: color 0.25s ease;
}

.home-category-card:hover h3,
.home-destination-card:hover h3 {
  color: #006D6F;
}

.home-category-card:focus-visible,
.home-destination-card a:focus-visible {
  outline: 3px solid #3DBCA8;
  outline-offset: 4px;
}

