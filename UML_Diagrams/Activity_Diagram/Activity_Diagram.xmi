<XMI xmi.version="1.2" xmlns:UML="org.omg.xmi.namespace.UML"><XMI.header><XMI.documentation><XMI.exporter>Goa Tourism UML artifacts</XMI.exporter><XMI.exporterVersion>1.0</XMI.exporterVersion></XMI.documentation><XMI.metamodel xmi.name="UML" xmi.version="1.4" /></XMI.header><XMI.content><UML:Model xmi.id="model_Activity_Diagram" name="Implemented Place Discovery Activity"><UML:Namespace.ownedElement><UML:Package xmi.id="pkg_flow" name="Implemented discovery workflow"><UML:Namespace.ownedElement><UML:ActionState xmi.id="act_3067542002507027463" name="Enter location or request browser location" /><UML:ActionState xmi.id="act_166580624494754447" name="Geocode typed location with Nominatim" /><UML:ActionState xmi.id="act_9180888160283845051" name="Query nearby places through Overpass" /><UML:ActionState xmi.id="act_915904653994101221" name="Filter results by keyword and category" /><UML:ActionState xmi.id="act_2181535938130046625" name="Show place cards and map" /><UML:ActionState xmi.id="act_799784987700155507" name="Toggle saved place in React state" /><UML:ActionState xmi.id="act_2779630714933949964" name="Open directions in Google Maps" /><UML:ActionState xmi.id="act_2683637662253901920" name="Save list disappears on refresh" /></UML:Namespace.ownedElement><UML:ModelElement.comment>Semantic action inventory for the accompanying SVG workflow. Booking/payment activities are not implemented.</UML:ModelElement.comment></UML:Package></UML:Namespace.ownedElement></UML:Model></XMI.content></XMI>