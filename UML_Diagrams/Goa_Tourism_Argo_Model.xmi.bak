    <XMI.metamodel xmi.name="UML" xmi.version="1.4" />
  </XMI.header>
  <XMI.content>
    <UML:Model xmi.id="model_goa_tourism" name="Goa Tourism Management System">
      <UML:Namespace.ownedElement>
        <UML:Package xmi.id="pkg_usecases" name="Implemented and planned use cases">
          <UML:Namespace.ownedElement>
            <UML:Actor xmi.id="actor_Tourist" name="Tourist" />
            <UML:Actor xmi.id="actor_Admin_(planned)" name="Admin (planned)" />
            <UML:Actor xmi.id="actor_External_Map_and_Geocoding_Services" name="External Map and Geocoding Services" />
            <UML:UseCase xmi.id="uc_3341826165119317505" name="Search location by place name">
              <UML:ModelElement.stereotype>Implemented</UML:ModelElement.stereotype>
            </UML:UseCase>
            <UML:UseCase xmi.id="uc_7699102705741753443" name="Search nearby using browser geolocation">
              <UML:ModelElement.stereotype>Implemented</UML:ModelElement.stereotype>
            </UML:UseCase>
            <UML:UseCase xmi.id="uc_6859458815859021061" name="Filter places by text and category">
              <UML:ModelElement.stereotype>Implemented</UML:ModelElement.stereotype>
            </UML:UseCase>
            <UML:UseCase xmi.id="uc_745864953035718587" name="View place cards and map markers">
              <UML:ModelElement.stereotype>Implemented</UML:ModelElement.stereotype>
            </UML:UseCase>
            <UML:UseCase xmi.id="uc_1299160614818652466" name="Open external directions">
              <UML:ModelElement.stereotype>Implemented</UML:ModelElement.stereotype>
            </UML:UseCase>
            <UML:UseCase xmi.id="uc_2386985311041946816" name="Save or remove place in current session">
              <UML:ModelElement.stereotype>Implemented; browser state only</UML:ModelElement.stereotype>
            </UML:UseCase>
            <UML:UseCase xmi.id="uc_3627460347689268666" name="Register and authenticate">
              <UML:ModelElement.stereotype>Planned; no UI/API implementation</UML:ModelElement.stereotype>
            </UML:UseCase>
            <UML:UseCase xmi.id="uc_5833153046168890419" name="Browse hotels and restaurants">
              <UML:ModelElement.stereotype>Planned; model schemas only</UML:ModelElement.stereotype>
            </UML:UseCase>
            <UML:UseCase xmi.id="uc_1570968955077483545" name="Explore tour packages">
              <UML:ModelElement.stereotype>Planned; model schema only</UML:ModelElement.stereotype>
            </UML:UseCase>
            <UML:UseCase xmi.id="uc_664689617886681738" name="Create booking">
              <UML:ModelElement.stereotype>Planned; model schema only</UML:ModelElement.stereotype>
            </UML:UseCase>
            <UML:UseCase xmi.id="uc_8071382024565643999" name="Pay for booking">
              <UML:ModelElement.stereotype>Planned; Payment schema only; no gateway integration</UML:ModelElement.stereotype>
            </UML:UseCase>
            <UML:UseCase xmi.id="uc_5834804367314424616" name="Submit review">
              <UML:ModelElement.stereotype>Planned; model schema only</UML:ModelElement.stereotype>
            </UML:UseCase>
            <UML:UseCase xmi.id="uc_5270496402625823374" name="Submit feedback">
              <UML:ModelElement.stereotype>Planned; model schema only</UML:ModelElement.stereotype>
            </UML:UseCase>
            <UML:UseCase xmi.id="uc_182888309143198216" name="Administer tourism content">
              <UML:ModelElement.stereotype>Planned; no admin UI/API implementation</UML:ModelElement.stereotype>
            </UML:UseCase>
          </UML:Namespace.ownedElement>
