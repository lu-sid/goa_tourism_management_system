        <UML:StateMachine xmi.id="bookingSM" name="Booking schema status lifecycle (behavior not implemented)">
          <UML:StateMachine.top>
            <UML:CompositeState xmi.id="bookingTop" name="Booking">
              <UML:Namespace.ownedElement>
                <UML:State xmi.id="state_Pending" name="Pending">
                  <UML:ModelElement.comment>Allowed Booking.status enum value; transitions are not implemented in source.</UML:ModelElement.comment>
                </UML:State>
                <UML:State xmi.id="state_Confirmed" name="Confirmed">
                  <UML:ModelElement.comment>Allowed Booking.status enum value; transitions are not implemented in source.</UML:ModelElement.comment>
                </UML:State>
                <UML:State xmi.id="state_Cancelled" name="Cancelled">
                  <UML:ModelElement.comment>Allowed Booking.status enum value; transitions are not implemented in source.</UML:ModelElement.comment>
                </UML:State>
                <UML:State xmi.id="state_Completed" name="Completed">
                  <UML:ModelElement.comment>Allowed Booking.status enum value; transitions are not implemented in source.</UML:ModelElement.comment>
                </UML:State>
              </UML:Namespace.ownedElement>
              <UML:ModelElement.comment>Pending is the schema default on creation. No controller or route implements status changes.</UML:ModelElement.comment>
            </UML:CompositeState>
          </UML:StateMachine.top>
        </UML:StateMachine>
        <UML:Package xmi.id="pkg_flow" name="Implemented discovery workflow">
          <UML:Namespace.ownedElement>
            <UML:ActionState xmi.id="act_3067542002507027463" name="Enter location or request browser location" />
            <UML:ActionState xmi.id="act_166580624494754447" name="Geocode typed location with Nominatim" />
            <UML:ActionState xmi.id="act_9180888160283845051" name="Query nearby places through Overpass" />
            <UML:ActionState xmi.id="act_915904653994101221" name="Filter results by keyword and category" />
            <UML:ActionState xmi.id="act_2181535938130046625" name="Show place cards and map" />
