<XMI xmi.version="1.2" xmlns:UML="org.omg.xmi.namespace.UML"><XMI.header><XMI.documentation><XMI.exporter>Goa Tourism UML artifacts</XMI.exporter><XMI.exporterVersion>1.0</XMI.exporterVersion></XMI.documentation><XMI.metamodel xmi.name="UML" xmi.version="1.4" /></XMI.header><XMI.content><UML:Model xmi.id="model_Sequence_Diagram" name="Live Place Search Sequence"><UML:Namespace.ownedElement><UML:Collaboration xmi.id="coll_discovery" name="Live place search (implemented frontend)"><UML:Collaboration.interaction><UML:Interaction xmi.id="interaction_discovery" name="Search nearby places"><UML:Interaction.context><UML:ClassifierRole xmi.id="role_Tourist" name="Tourist" /><UML:ClassifierRole xmi.id="role_ReactApp" name="ReactApp" /><UML:ClassifierRole xmi.id="role_Nominatim" name="Nominatim" /><UML:ClassifierRole xmi.id="role_OverpassAPI" name="OverpassAPI" /><UML:ClassifierRole xmi.id="role_ReactLeaflet" name="ReactLeaflet" /><UML:ClassifierRole xmi.id="role_GoogleMaps" name="GoogleMaps" /></UML:Interaction.context><UML:ModelElement.comment>Actual code uses browser fetch to Nominatim and Overpass; no backend API, controllers, MongoDB call, or payment gateway participates in this workflow.</UML:ModelElement.comment></UML:Interaction></UML:Collaboration.interaction></UML:Collaboration></UML:Namespace.ownedElement></UML:Model></XMI.content></XMI>