<?xml version='1.0' encoding='UTF-8'?>
<XMI xmi.version="1.2" xmlns:UML="org.omg.xmi.namespace.UML"><XMI.header><XMI.documentation><XMI.exporter>Goa Tourism UML artifacts</XMI.exporter><XMI.exporterVersion>1.0</XMI.exporterVersion></XMI.documentation><XMI.metamodel xmi.name="UML" xmi.version="1.4" /></XMI.header><XMI.content><UML:Model xmi.id="model_State_Diagram" name="Booking Status Values"><UML:Namespace.ownedElement><UML:StateMachine xmi.id="bookingSM" name="Booking schema status lifecycle (behavior not implemented)"><UML:StateMachine.top><UML:CompositeState xmi.id="bookingTop" name="Booking"><UML:Namespace.ownedElement><UML:State xmi.id="state_Pending" name="Pending"><UML:ModelElement.comment>Allowed Booking.status enum value; transitions are not implemented in source.</UML:ModelElement.comment></UML:State><UML:State xmi.id="state_Confirmed" name="Confirmed"><UML:ModelElement.comment>Allowed Booking.status enum value; transitions are not implemented in source.</UML:ModelElement.comment></UML:State><UML:State xmi.id="state_Cancelled" name="Cancelled"><UML:ModelElement.comment>Allowed Booking.status enum value; transitions are not implemented in source.</UML:ModelElement.comment></UML:State><UML:State xmi.id="state_Completed" name="Completed"><UML:ModelElement.comment>Allowed Booking.status enum value; transitions are not implemented in source.</UML:ModelElement.comment></UML:State></UML:Namespace.ownedElement><UML:ModelElement.comment>Pending is the schema default on creation. No controller or route implements status changes.</UML:ModelElement.comment></UML:CompositeState></UML:StateMachine.top></UML:StateMachine></UML:Namespace.ownedElement></UML:Model></XMI.content></XMI>